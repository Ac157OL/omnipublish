DATABASE_URL="postgresql://postgres:postgres@localhost:5432/omnipublish?schema=public"
REDIS_URL="redis://localhost:6379"

# Generate with: openssl rand -base64 32
AUTH_SECRET=""

S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="omnipublish"
S3_ACCESS_KEY_ID="minio"
S3_SECRET_ACCESS_KEY="minio123"

DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"

MINIMAX_API_KEY=""
MINIMAX_BASE_URL="https://api.minimax.chat"
MINIMAX_GROUP_ID=""
MINIMAX_IMAGE_MODEL="image-01"

# Worker metric recrawl cron (BullMQ repeat pattern, default: every hour)
METRIC_RECRAWL_CRON="0 * * * *"

# Generate with: openssl rand -hex 32
CREDENTIAL_ENCRYPTION_KEY=""
PUBLIC_APP_URL="http://localhost:8080"

# ===== 微信公众号（订阅号/服务号，需在公众号后台「基本配置」获取）=====
# 主要凭证走 UI 账号设置页填写并加密入库；此处仅用于 adapter 冒烟测试直连
WECHAT_APP_ID=""
WECHAT_APP_SECRET=""
# 注意：调 access_token 的机器出口 IP 必须加入公众号后台「IP 白名单」
# 个人订阅号无 freepublish/submit 直发权限（会返 48001），仅草稿可用

# ===== 博客园（XML-RPC MetaWeblog）=====
# 主要凭证走 UI 账号设置页填写并加密入库；此处仅用于 adapter 冒烟测试直连
CNBLOGS_BLOG_APP=""
# 重要：username 字段填「邮箱」不是登录用户名
CNBLOGS_USERNAME=""
CNBLOGS_EMAIL=""
# 重要：password 字段填「个人访问令牌」(Personal Access Token)，不是登录密码
# 在 https://i.cnblogs.com/settings#enableServiceAccess 生成
CNBLOGS_PASSWORD=""
# MetaWeblog 访问令牌（旧版博客园 API Key，作为 XML-RPC source name 用）
CNBLOGS_METAWEBLOG_TOKEN=""
